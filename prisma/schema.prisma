// Engineer Cafe — relational schema
// Chai. Paratha. Aur Engineering Wali Vibes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CASH_AT_COUNTER
  ONLINE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
}

enum AddonGroupType {
  SINGLE
  MULTIPLE
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  staffAccess StaffAccess?
  businessParty BusinessParty?
  favorites Favorite[]
  loyaltyEntries LoyaltyEntry[]
  pushSubscriptions PushSubscription[]

  @@index([role])
  @@index([createdAt])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String   @default("Home")
  fullName    String
  phone       String
  addressLine String
  area        String?
  city        String
  notes       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([slug])
}

model Product {
  id              String     @id @default(cuid())
  name            String
  /// Name as printed on the cafe's Urdu menu board, shown alongside the English name.
  urduName        String?
  slug            String     @unique
  description     String
  longDescription String?
  categoryId      String
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price           Int // stored in PKR (whole rupees)
  discountPrice   Int?
  image           String?
  isAvailable     Boolean    @default(true)
  isFeatured      Boolean    @default(false)
  isPopular       Boolean    @default(false)
  isVegetarian    Boolean    @default(false)
  spiceLevel      SpiceLevel @default(NONE)
  prepTimeMinutes Int        @default(10)
  ingredients     String[]   @default([])
  calories        Int?
  stock           Int? // null = unlimited
  sortOrder       Int        @default(0)
  ratingAverage   Float      @default(0)
  ratingCount     Int        @default(0)
  soldCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  recipe Recipe?
  recipeRequired Boolean @default(true)
  addonGroups AddonGroupOnProduct[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  comboItems  ComboItem[]

  @@index([categoryId])
  @@index([isAvailable, isPopular])
  @@index([slug])
}

// A combo product is a normal Product in the "combos" category that references
// the items it bundles — powers the "Engineer's Deals" homepage section.
model ComboItem {
  id        String  @id @default(cuid())
  comboId   String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([comboId, productId])
  @@index([comboId])
}

model AddonGroup {
  id         String         @id @default(cuid())
  name       String
  slug       String         @unique
  type       AddonGroupType @default(SINGLE)
  isRequired Boolean        @default(false)
  minSelect  Int            @default(0)
  maxSelect  Int            @default(1)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  addons   ProductAddon[]
  products AddonGroupOnProduct[]
}

model AddonGroupOnProduct {
  productId    String
  addonGroupId String
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  addonGroup AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)

  @@id([productId, addonGroupId])
  @@index([addonGroupId])
}

model ProductAddon {
  id           String     @id @default(cuid())
  addonGroupId String
  addonGroup   AddonGroup @relation(fields: [addonGroupId], references: [id], onDelete: Cascade)
  name         String
  price        Int        @default(0)
  isDefault    Boolean    @default(false)
  isAvailable  Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  recipe Recipe?
  orderItemAddons OrderItemAddon[]

  @@index([addonGroupId])
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String?
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Int
  minOrderAmount Int          @default(0)
  maxDiscount    Int? // caps percentage discounts
  maxUsage       Int? // null = unlimited
  usageCount     Int          @default(0)
  perUserLimit   Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@index([code])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerPhone String
  customerEmail String?

  orderType     OrderType     @default(DELIVERY)
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?
  channel       String @default("WEB")
  requestKey    String? @unique
  requestHash   String?
  scheduledAt   DateTime?
  cashReceived  Int?
  cashChange    Int?
  loyaltyPointsUsed Int @default(0)
  loyaltyDiscount Int @default(0)
  loyaltyPointsEarned Int @default(0)

  cashTendered Decimal? @db.Decimal(18,2)
  changeGiven Decimal? @db.Decimal(18,2)
  tableName String?
  waiterName String?
  businessTracked Boolean @default(false)
  businessConsumedAt DateTime?
  businessInvoicedAt DateTime?
  businessVoidedAt DateTime?
  businessCredit Boolean @default(false)
  businessPartyId String?
  businessParty BusinessParty? @relation(fields:[businessPartyId],references:[id],onDelete:Restrict)
  serviceMode String @default("TAKEAWAY")
  tableSessionId String?
  tableSession TableSession? @relation(fields:[tableSessionId],references:[id],onDelete:Restrict)
  cashShiftId String?
  cashShift CashShift? @relation(fields:[cashShiftId],references:[id],onDelete:Restrict)
  amountPaid Decimal @default(0) @db.Decimal(18,2)
  amountRefunded Decimal @default(0) @db.Decimal(18,2)
  ingredientReservations IngredientReservation[]
  stockMovements StockMovement[]
  businessJournals BusinessJournal[]
  businessPayments BusinessPayment[]
  businessSaleLines BusinessSaleLine[]
  approvals CafeApproval[]
  addressLine  String?
  area         String?
  city         String?
  instructions String?

  subtotal    Int
  discount    Int @default(0)
  deliveryFee Int @default(0)
  tax         Int @default(0)
  total       Int

  couponId   String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode String?

  estimatedMinutes Int       @default(25)
  cancelReason     String?
  placedAt         DateTime  @default(now())
  confirmedAt      DateTime?
  readyAt          DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([scheduledAt, status])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // denormalised so historical orders survive product edits/deletes
  productName  String
  productSlug  String
  productImage String?
  unitPrice    Int // base price after product discount, excluding addons
  addonsTotal  Int     @default(0)
  quantity     Int
  lineTotal    Int
  notes        String?

  addons OrderItemAddon[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemAddon {
  id          String        @id @default(cuid())
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonId     String?
  addon       ProductAddon? @relation(fields: [addonId], references: [id], onDelete: SetNull)

  groupName String
  addonName String
  price     Int    @default(0)

  @@index([orderItemId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status])
}

// Single-row key/value store for runtime-configurable cafe settings.
model CafeSetting {
  id           Int     @id @default(1)
  cafeName     String  @default("Engineer Cafe")
  tagline      String  @default("Chai. Paratha. Aur Engineering Wali Vibes.")
  logoUrl      String?
  phone        String  @default("+92 300 1234567")
  whatsapp     String  @default("923001234567")
  email        String  @default("hello@engineercafe.pk")
  address      String  @default("Hostel City, Chatta Bakhtawar, Islamabad")
  city         String  @default("Islamabad")
  mapsQuery    String  @default("Hostel City, Chatta Bakhtawar, Islamabad, Pakistan")
  openingHours String  @default("Mon–Sun · 8:00 AM – 2:00 AM")

  /// Storefront and admin palette. One of the presets in globals.css.
  theme        String  @default("chai")

  deliveryFee      Int    @default(80)
  freeDeliveryOver Int?   @default(1500)
  minOrderAmount   Int    @default(300)
  taxPercent       Float  @default(0)
  currency         String @default("PKR")
  currencySymbol   String @default("Rs.")

  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?

  codEnabled           Boolean @default(true)
  cashAtCounterEnabled Boolean @default(true)
  onlinePaymentEnabled Boolean @default(false)
  isAcceptingOrders    Boolean @default(true)

  loyaltyEnabled Boolean @default(true)
  loyaltyEarnEvery Int @default(100)
  loyaltyRewardPoints Int @default(100)
  loyaltyRewardValue Int @default(100)
  schedulingEnabled Boolean @default(true)
  scheduleLeadMinutes Int @default(30)
  scheduleDaysAhead Int @default(7)
  scheduleOpenMinute Int @default(480)
  scheduleCloseMinute Int @default(120)
  updatedAt DateTime @default(now()) @updatedAt
}

// Ledgers deliberately retain the order key after an admin deletes an order.
model LoyaltyEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderKey String
  kind String
  points Int
  createdAt DateTime @default(now())
  @@unique([orderKey, kind])
  @@index([userId, createdAt])
}
model PushSubscription {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh String
  auth String
  createdAt DateTime @default(now())
}
model NotificationJob {
  id String @id @default(cuid())
  eventKey String @unique
  title String
  body String
  url String
  attempts Int @default(0)
  availableAt DateTime @default(now())
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  @@index([deliveredAt, availableAt])
}
model OrderCounter {
  id Int @id @default(1)
  value Int @default(999)
}

// Operational and accounting records. Posted ledgers are append-only.
model BusinessConfig {
  id Int @id @default(1)
  enabled Boolean @default(false)
  enabledAt DateTime?
  lockedThrough DateTime? @db.Date
  updatedAt DateTime @updatedAt
}
model StaffAccess {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  profile String
  employeeId String? @unique
  employee Employee? @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  updatedAt DateTime @updatedAt
}
model BusinessParty {
  purchaseOrders CafePurchaseOrder[]
  id String @id @default(cuid())
  kind String
  name String
  phone String?
  email String?
  address String?
  userId String? @unique
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  creditLimit Decimal @default(0) @db.Decimal(18,2)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee Employee?
  postings BusinessPosting[]
  purchases BusinessPurchase[]
  payments BusinessPayment[]
  orders Order[]
  @@index([kind,isActive])
}
model Employee {
  id String @id @default(cuid())
  code String @unique
  partyId String @unique
  party BusinessParty @relation(fields:[partyId],references:[id],onDelete:Restrict)
  designation String
  payBasis String @default("MONTHLY")
  basePay Decimal @db.Decimal(18,2)
  overtimeRate Decimal @default(0) @db.Decimal(18,2)
  joinedOn DateTime @db.Date
  leftOn DateTime? @db.Date
  isActive Boolean @default(true)
  notes String?
  updatedAt DateTime @updatedAt
  access StaffAccess?
  attendance Attendance[]
  payroll PayrollRecord[]
  sessions TableSession[]
}
model Attendance {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  date DateTime @db.Date
  status String
  clockIn DateTime?
  clockOut DateTime?
  overtimeHours Decimal @default(0) @db.Decimal(10,4)
  notes String?
  recordedBy String
  updatedAt DateTime @updatedAt
  @@unique([employeeId,date])
  @@index([date])
}
model PayrollRecord {
  id String @id @default(cuid())
  employeeId String
  employee Employee @relation(fields:[employeeId],references:[id],onDelete:Restrict)
  period String
  startsOn DateTime @db.Date
  endsOn DateTime @db.Date
  status String @default("DRAFT")
  basePay Decimal @db.Decimal(18,2)
  unpaidDeduction Decimal @db.Decimal(18,2)
  overtimePay Decimal @db.Decimal(18,2)
  bonus Decimal @default(0) @db.Decimal(18,2)
  manualDeduction Decimal @default(0) @db.Decimal(18,2)
  advanceApplied Decimal @default(0) @db.Decimal(18,2)
  earnedPay Decimal @db.Decimal(18,2)
  netPay Decimal @db.Decimal(18,2)
  sourceHash String
  snapshot Json
  note String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments BusinessPayment[]
  @@index([period,status])
}
model Ingredient {
  id String @id @default(cuid())
  name String @unique
  unit String
  quantity Decimal @default(0) @db.Decimal(18,4)
  stockValue Decimal @default(0) @db.Decimal(18,2)
  reorderAt Decimal @default(0) @db.Decimal(18,4)
  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt
  recipeLines RecipeLine[]
  reservations IngredientReservation[]
  movements StockMovement[]
  purchases PurchaseLine[]
}
model Recipe {
  id String @id @default(cuid())
  productId String? @unique
  product Product? @relation(fields:[productId],references:[id],onDelete:Restrict)
  addonId String? @unique
  addon ProductAddon? @relation(fields:[addonId],references:[id],onDelete:Restrict)
  yieldUnits Decimal @default(1) @db.Decimal(12,4)
  note String?
  updatedAt DateTime @updatedAt
  lines RecipeLine[]
}
model RecipeLine {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields:[recipeId],references:[id],onDelete:Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  quantity Decimal @db.Decimal(18,4)
  @@unique([recipeId,ingredientId])
}
model StockMovement {
  id String @id @default(cuid())
  eventKey String @unique
  ingredientId String
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  kind String
  quantity Decimal @db.Decimal(18,4)
  value Decimal @db.Decimal(18,2)
  balanceQuantity Decimal @db.Decimal(18,4)
  balanceValue Decimal @db.Decimal(18,2)
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  orderItemKey String?
  purchaseLineId String?
  note String
  actorName String
  createdAt DateTime @default(now())
  @@index([ingredientId,createdAt])
  @@index([orderId])
}
model BusinessAccount {
  id String @id @default(cuid())
  code String @unique
  name String
  kind String
  isMoney Boolean @default(false)
  isActive Boolean @default(true)
  postings BusinessPosting[]
  drawer CashDrawer?
  payments BusinessPayment[]
}
model BusinessJournal {
  id String @id @default(cuid())
  eventKey String @unique
  source String
  sourceId String
  date DateTime @db.Date
  note String
  actorId String
  actorName String
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  shiftId String?
  shift CashShift? @relation(fields:[shiftId],references:[id],onDelete:Restrict)
  reversalOfId String? @unique
  reversalOf BusinessJournal? @relation("Reversal",fields:[reversalOfId],references:[id],onDelete:Restrict)
  reversedBy BusinessJournal? @relation("Reversal")
  createdAt DateTime @default(now())
  postings BusinessPosting[]
  payments BusinessPayment[]
  @@index([date,source])
  @@index([orderId])
}
model BusinessPosting {
  id String @id @default(cuid())
  journalId String
  journal BusinessJournal @relation(fields:[journalId],references:[id],onDelete:Restrict)
  accountId String
  account BusinessAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  partyId String?
  party BusinessParty? @relation(fields:[partyId],references:[id],onDelete:Restrict)
  debit Decimal @default(0) @db.Decimal(18,2)
  credit Decimal @default(0) @db.Decimal(18,2)
  @@index([accountId,journalId])
  @@index([partyId])
}
model BusinessPurchase {
  purchaseOrder CafePurchaseOrder?
  id String @id @default(cuid())
  supplierId String
  supplier BusinessParty @relation(fields:[supplierId],references:[id],onDelete:Restrict)
  invoiceNumber String
  date DateTime @db.Date
  status String @default("POSTED")
  total Decimal @db.Decimal(18,2)
  note String?
  createdAt DateTime @default(now())
  lines PurchaseLine[]
  payments BusinessPayment[]
  @@unique([supplierId,invoiceNumber])
}
model PurchaseLine {
  id String @id @default(cuid())
  purchaseId String
  purchase BusinessPurchase @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  ingredientId String
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  quantity Decimal @db.Decimal(18,4)
  totalCost Decimal @db.Decimal(18,2)
  returnedQuantity Decimal @default(0) @db.Decimal(18,4)
  returnedCost Decimal @default(0) @db.Decimal(18,2)
}
model BusinessPayment {
  id String @id @default(cuid())
  kind String
  partyId String?
  party BusinessParty? @relation(fields:[partyId],references:[id],onDelete:Restrict)
  orderId String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  purchaseId String?
  purchase BusinessPurchase? @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  payrollId String?
  payroll PayrollRecord? @relation(fields:[payrollId],references:[id],onDelete:Restrict)
  accountId String
  account BusinessAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  journalId String
  journal BusinessJournal @relation(fields:[journalId],references:[id],onDelete:Restrict)
  amount Decimal @db.Decimal(18,2)
  date DateTime @db.Date
  note String
  createdAt DateTime @default(now())
  @@index([partyId,date])
  @@index([orderId])
  @@index([payrollId])
}
model CashDrawer {
  id String @id @default(cuid())
  name String @unique
  accountId String @unique
  account BusinessAccount @relation(fields:[accountId],references:[id],onDelete:Restrict)
  isActive Boolean @default(true)
  shifts CashShift[]
}
model CashShift {
  id String @id @default(cuid())
  drawerId String
  drawer CashDrawer @relation(fields:[drawerId],references:[id],onDelete:Restrict)
  openedById String
  openedByName String
  openingCash Decimal @db.Decimal(18,2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  expectedCash Decimal? @db.Decimal(18,2)
  actualCash Decimal? @db.Decimal(18,2)
  variance Decimal? @db.Decimal(18,2)
  closeNote String?
  closedById String?
  closedByName String?
  denominations Json?
  reviewedAt DateTime?
  reviewedById String?
  reviewedByName String?
  reviewNote String?
  journals BusinessJournal[]
  orders Order[]
}
model CafeTable {
  id String @id @default(cuid())
  name String @unique
  seats Int @default(4)
  isActive Boolean @default(true)
  sessions TableSession[]
}
model TableSession {
  id String @id @default(cuid())
  tableId String
  table CafeTable @relation(fields:[tableId],references:[id],onDelete:Restrict)
  waiterId String?
  waiter Employee? @relation(fields:[waiterId],references:[id],onDelete:Restrict)
  openedById String
  guestCount Int @default(1)
  openedAt DateTime @default(now())
  closedAt DateTime?
  orders Order[]
}
model BusinessSaleLine {
  id String @id @default(cuid())
  eventKey String @unique
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  orderItemKey String
  productName String
  quantity Int
  gross Decimal @db.Decimal(18,2)
  discount Decimal @db.Decimal(18,2)
  net Decimal @db.Decimal(18,2)
  cost Decimal @db.Decimal(18,2)
  date DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([date])
}
model BusinessAudit {
  id String @id @default(cuid())
  actorId String
  actorName String
  action String
  entity String
  entityId String
  details Json
  createdAt DateTime @default(now())
  @@index([entity,entityId])
  @@index([createdAt])
}
model BusinessRequest {
  key String @id
  payloadHash String
  result Json
  createdAt DateTime @default(now())
}

model IngredientReservation {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields:[orderId],references:[id],onDelete:Restrict)
  orderItemKey String
  ingredientId String
  ingredient Ingredient @relation(fields:[ingredientId],references:[id],onDelete:Restrict)
  quantity Decimal @db.Decimal(18,4)
  consumedAt DateTime?
  releasedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([orderId,orderItemKey,ingredientId])
  @@index([ingredientId,consumedAt,releasedAt])
}

// Purchase orders are commitments only. Receipt posts an existing purchase invoice.
model CafePurchaseOrder {
  id String @id @default(cuid())
  reference String @unique
  supplierId String
  supplierName String
  supplier BusinessParty @relation(fields:[supplierId],references:[id],onDelete:Restrict)
  expectedOn DateTime @db.Date
  status String @default("DRAFT")
  lines Json
  total Decimal @db.Decimal(18,2)
  note String
  createdById String
  createdByName String
  approvedById String?
  approvedByName String?
  approvedAt DateTime?
  purchaseId String? @unique
  purchase BusinessPurchase? @relation(fields:[purchaseId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
}
model CafeStockCount {
  id String @id @default(cuid())
  reference String @unique
  status String @default("DRAFT")
  date DateTime @db.Date
  lines Json
  note String
  createdById String
  createdByName String
  postedByName String?
  postedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status,createdAt])
}
model CafeApproval {
  id String @id @default(cuid())
  kind String
  orderId String?
  orderNumber String?
  order Order? @relation(fields:[orderId],references:[id],onDelete:Restrict)
  scopeHash String?
  context Json?
  amount Decimal @db.Decimal(18,2)
  reason String
  status String @default("PENDING")
  requestedById String
  requestedByName String
  reviewedById String?
  reviewedByName String?
  reviewNote String?
  reviewedAt DateTime?
  usedAt DateTime?
  resultId String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([status,createdAt])
  @@index([requestedById,status])
}
