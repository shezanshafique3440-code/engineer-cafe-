# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/engineer_cafe?schema=public"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
JWT_SECRET="replace-with-a-long-random-string"

# ─── URLs ───────────────────────────────────────────────────────────────────
API_URL="http://localhost:3000/api"
FRONTEND_URL="http://localhost:3000"
# Public canonical URL used for SEO metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Contact / ordering ─────────────────────────────────────────────────────
# Fallback WhatsApp number (digits only, incl. country code) if none is set in admin settings.
WHATSAPP_NUMBER="923001234567"

# ─── Payments (modular — provider can be plugged in later) ──────────────────
# none | stripe | jazzcash | easypaisa
PAYMENT_PROVIDER="none"
PAYMENT_SECRET=""
PAYMENT_PUBLIC_KEY=""

# ─── Image uploads ──────────────────────────────────────────────────────────
# local | cloudinary | s3
UPLOAD_PROVIDER="local"
UPLOAD_SECRET=""
# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# S3 / R2 / MinIO compatible
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ─── Seed credentials (used only by `npm run db:seed`) ──────────────────────
SEED_ADMIN_EMAIL="admin@engineercafe.pk"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="change-me-before-seeding"
