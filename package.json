{
  "name": "engineer-cafe",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test src/lib/__tests__/*.test.ts",
    "test:integration": "node scripts/tests/run-integration.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "framer-motion": "^12.43.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "web-push": "^4.0.0",
    "zod": "4.6.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "pg": "8.16.3",
    "playwright": "1.56.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "source-map-js": "1.2.2",
    "uuid": "11.1.1",
    "postcss": "8.5.32",
    "brace-expansion@<2": "1.1.21",
    "minimatch@>=7 <11.0.1": "11.0.1",
    "postcss-selector-parser@<6.1.5": "6.1.5"
  }
}
